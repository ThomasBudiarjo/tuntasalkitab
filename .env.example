# Server configuration
PORT=8493
# Required. Must be at least 16 bytes; generate with: openssl rand -base64 32
SESSION_SECRET=

# Database configuration
DATABASE_PATH=bible-tracker.db
# Optional Turso/libSQL - set both to use Turso instead of DATABASE_PATH.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Google OAuth.
# GOOGLE_CLIENT_ID is required in production for Android /api/v1/auth/google.
# GOOGLE_CLIENT_SECRET and GOOGLE_REDIRECT_URL are used by the existing website
# sign-in flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8493/auth/google/callback