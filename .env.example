# Server configuration
PORT=8080
DATABASE_PATH=bible-tracker.db

# Application environment: "development" or "production"
# In production, SESSION_SECRET is required and cookies use Secure flag
APP_ENV=development

# Session secret key (REQUIRED in production, optional in development)
# Generate a strong random key: openssl rand -base64 32
SESSION_SECRET=your-secret-key-here-change-in-production

# Google OAuth (optional - leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback
