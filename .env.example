# Server configuration
PORT=8493
SESSION_SECRET=your-secret-key-here-change-in-production

# Database configuration
DATABASE_PATH=bible-tracker.db
# Optional Turso/libSQL - set both to use Turso instead of DATABASE_PATH.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Google OAuth (optional - leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8493/auth/google/callback